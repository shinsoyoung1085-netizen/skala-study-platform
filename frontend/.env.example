# SKALA STUDY - Frontend 환경변수 예시
# 실제 값은 .env 파일로 복사해서 사용하세요.

VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 (Google 로그인) - 백엔드와 동일한 클라이언트 ID를 사용합니다.
# GCP Console(https://console.cloud.google.com/apis/credentials)에서 발급받은
# "OAuth 클라이언트 ID"의 클라이언트 ID 값을 입력합니다.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
