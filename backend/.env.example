# ==============================
# SKALA STUDY - Backend 환경변수 예시
# 실제 값은 .env 파일로 복사해서 사용하세요. (.env는 git에 커밋하지 않습니다)
# ==============================

# PostgreSQL 접속 정보
DATABASE_URL=postgresql://skala_user:skala_password@localhost:5432/skala_study

# JWT 설정
JWT_SECRET_KEY=change-this-secret-key-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# "로그인 유지" 선택 시 사용되는 장기 만료 시간(분) - 기본 7일
ACCESS_TOKEN_REMEMBER_EXPIRE_MINUTES=10080

# CORS 허용 오리진 (콤마로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 (Google 로그인)
# GCP Console(https://console.cloud.google.com/apis/credentials)에서 발급받은
# "OAuth 클라이언트 ID"의 클라이언트 ID 값을 입력합니다. (client_secret은 백엔드에서 불필요 - ID 토큰 검증 방식)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 후기/건의 게시판의 "AI 초안 생성" 기능 (https://console.anthropic.com 에서 발급)
# 비워두면 AI 초안 생성 버튼이 503 에러를 반환하며, 기능 자체는 비활성화된 채로 나머지 서비스는 정상 동작합니다.
ANTHROPIC_API_KEY=
