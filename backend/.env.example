# ==============================
# SKALA STUDY - Backend 환경변수 예시
# 실제 값은 .env 파일로 복사해서 사용하세요. (.env는 git에 커밋하지 않습니다)
# ==============================

# PostgreSQL 접속 정보
DATABASE_URL=postgresql://skala_user:skala_password@localhost:5432/skala_study

# JWT 설정
JWT_SECRET_KEY=change-this-secret-key-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# "로그인 유지" 선택 시 사용되는 장기 만료 시간(분) - 기본 7일
ACCESS_TOKEN_REMEMBER_EXPIRE_MINUTES=10080

# CORS 허용 오리진 (콤마로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
